{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "0.1.0",
  "identifier": "com.nook.atlas",
  "build": {
    "beforeDevCommand": "npm --prefix frontend start",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "Atlas",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": ["../config.yaml"],
    "externalBin": ["binaries/atlas-backend"]
  }
}
